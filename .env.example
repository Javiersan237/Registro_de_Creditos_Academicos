# Configuración del servidor central (producción). Copia este archivo como .env y llena los valores.
# .env NO se sube a Git. La laptop del salón no usa este archivo: su lanzador escribe el suyo.
# Con DJANGO_DEBUG=0 la app NO arranca si falta DJANGO_SECRET_KEY o si alguna clave sigue con un valor de ejemplo.
# Para generar una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"

# ----------------------------------------------------------------------------- Django
# Llave maestra: firma sesiones y formularios. Larga y al azar. Si cambia, todos deben volver a iniciar sesión.
DJANGO_SECRET_KEY=
# 0 = producción: errores con una página genérica (el detalle queda en el registro del servidor).
# 1 = desarrollo: muestra el código, las variables y la configuración al fallar. Nunca 1 en un servidor real.
# Sin la variable vale 0.
DJANGO_DEBUG=0
# Direcciones con las que se puede abrir el sitio, separadas por coma (p. ej. renueva.pythonanywhere.com).
# Vacía con DJANGO_DEBUG=0: Django rechaza todas las peticiones (error 400). * acepta cualquiera (solo desarrollo
# o la red local del salón, donde la IP cambia).
DJANGO_ALLOWED_HOSTS=
# Direcciones completas con https:// desde las que se aceptan formularios, separadas por coma. Solo hace falta si
# el sitio se abre por una dirección distinta de la que recibe Django (p. ej. un túnel https://xxxx.trycloudflare.com);
# si falta en ese caso, iniciar sesión falla con «CSRF verification failed». Vacía: solo la propia dirección del sitio.
CSRF_TRUSTED_ORIGINS=
# 1 = el sitio se sirve por HTTPS: las cookies de sesión solo viajan cifradas.
# 0 = HTTP simple (red local del salón). Con 1 y sin HTTPS nadie puede iniciar sesión, porque la cookie no se guarda.
HTTPS=1

# ----------------------------------------------------------------------------- Correo
# Servidor SMTP y puerto (587 = SMTP con TLS).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Cuenta y contraseña de aplicación (Gmail: verificación en 2 pasos + contraseña de aplicación de 16 letras).
# Vacías: los correos no se envían; se guardan como archivos en la carpeta outbox/ para revisarlos.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente que ve el alumno.
EMAIL_FROM=Renueva TI <avisos@tu-dominio.mx>

# ----------------------------------------------------------------------------- WhatsApp (servicio en whatsapp_service/)
# 1 = Django manda avisos por WhatsApp (requiere el servicio encendido y vinculado). 0 = no intenta enviarlos.
WHATSAPP_ENABLED=0
# Dirección del servicio. 127.0.0.1 = esta misma computadora: no se puede alcanzar desde otra.
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
# Contraseña entre Django y el servicio. Obligatoria: sin ella (o con un valor de ejemplo) el servicio no arranca,
# y con WHATSAPP_ENABLED=1 y DJANGO_DEBUG=0 Django tampoco.
WHATSAPP_TOKEN=
# Puerto en el que escucha el servicio. Si cambia, cambia también el de WHATSAPP_SERVICE_URL.
WHATSAPP_PORT=3001
# Lada del país que se antepone a los números de 10 dígitos (52 = México).
WHATSAPP_LADA_PAIS=52

# ----------------------------------------------------------------------------- Avisos
# prueba = solo salen avisos a las listas blancas de abajo; a los demás se les registra como «simulado».
# real = se envían a todos los alumnos. Cambiar a real solo al arrancar la operación con alumnos reales.
NOTIF_MODO=prueba
# Correos y teléfonos (10 dígitos) que sí reciben avisos en modo prueba, separados por coma.
NOTIF_LISTA_BLANCA_CORREOS=
NOTIF_LISTA_BLANCA_TELEFONOS=

# ----------------------------------------------------------------------------- Firma de los QR
# Firma de los QR del profesor. Vacía usa DJANGO_SECRET_KEY. Si cambia, los QR ya proyectados dejan de valer.
QR_SIGNING_KEY=

# ----------------------------------------------------------------------------- NIP de los alumnos
# Clave con la que se guarda el NIP (HMAC). Vacía usa DJANGO_SECRET_KEY. Si cambia (o cambia DJANGO_SECRET_KEY
# estando vacía), ningún NIP guardado coincide: hay que volver a cargar el padrón.
NIP_KEY=
# NIP incorrectos seguidos antes de bloquear al alumno, y minutos que dura el bloqueo.
NIP_MAX_INTENTOS=5
NIP_BLOQUEO_MIN=15

# ----------------------------------------------------------------------------- Contraseñas del personal
# Una distinta por usuario (la de admin, muy larga). Las usa generar_datos, que es solo para pruebas;
# en producción las cuentas se crean y se cambian en /admin/. No las subas al repositorio.
CLAVE_PROFESOR=
CLAVE_COMITE=
CLAVE_SERVICIOS=
CLAVE_ADMIN=

# ----------------------------------------------------------------------------- Datos de prueba (generar_datos)
# Docente y grupo de la conferencia de ejemplo. Vacías: «Profesor Demo 03» y «A». No uses nombres reales.
DEMO_DOCENTE=
DEMO_GRUPO=

# ----------------------------------------------------------------------------- Archivo para el SIIC
# Separador de columnas del CSV (, ; o \t para tabulador).
EXPORT_SEPARADOR=,
# Codificación: utf-8 (lleva marca BOM para que Excel muestre los acentos) o cp1252 si el SIIC la pide (sin BOM).
EXPORT_CODIFICACION=utf-8

# ----------------------------------------------------------------------------- Modo B (laptop del profesor sin internet)
# 0 = servidor central. 1 = laptop que recibe registros por la red local y luego los sube con «Sincronizar».
MODO_LOCAL=0
# Solo con MODO_LOCAL=1: dirección del servidor central al que se suben los registros. Vacía: no se sincroniza.
CENTRAL_URL=
