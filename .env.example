# Copia este archivo como .env y llena los valores. .env NO se sube a Git.
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Si usas un túnel HTTPS (cloudflared), agrega su dirección: https://xxxx.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# --- Correo (Gmail de pruebas con verificación en 2 pasos + contraseña de aplicación) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Renueva TI <tu.cuenta.de.pruebas@gmail.com>

# --- WhatsApp (servicio Node en whatsapp_service/) ---
WHATSAPP_ENABLED=0
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_TOKEN=cambia-este-token
WHATSAPP_PORT=3001
WHATSAPP_LADA_PAIS=52

# --- Seguridad de los avisos ---
# prueba: solo se envía a la lista blanca. real: se envía a todos.
NOTIF_MODO=prueba
NOTIF_LISTA_BLANCA_CORREOS=
NOTIF_LISTA_BLANCA_TELEFONOS=

# --- Firma de los QR ---
QR_SIGNING_KEY=cambia-esto-tambien

# --- Modo B: laptop del profesor sin internet ---
MODO_LOCAL=0
CENTRAL_URL=
